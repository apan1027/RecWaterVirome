\name{RecWaterVirome}
\alias{RecWaterVirome}
\alias{RecWaterVirome-package}
\docType{package}
\title{Wastewater and Reclaimed-Water Virome Analyses}
\description{
R functions supporting community analyses, saved-result figures and
supplementary table assembly for the RecWaterVirome study.
}
\details{
Open the project file and read the paired Quarto and Markdown documents in
\file{analyses/}. Required processed inputs are supplied separately and listed
in \file{analyses/data/inputs.tsv}. Optional model scripts are in \file{dev/}.
Functions in this package are internal helpers for those analyses.
}
\author{Jinlong Ru; Cunli Pan. Maintainer: Cunli Pan.}
\keyword{package}
